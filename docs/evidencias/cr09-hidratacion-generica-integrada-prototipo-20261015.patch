+
+
+@pytest.mark.parametrize('failure', [False, True])
+@pytest.mark.parametrize('bounded,prepared', [(True, True), (True, False), (False, True)])
+def test_explicit_generic_scope_restores_custom_policy_and_sql_errors(request, failure, bounded, prepared):
+    request.getfixturevalue('directory')
+    initial = settings_now()
+    raw = connection.connection
+    factory, threshold = raw.cursor_factory, raw.prepare_threshold
+    with transaction.atomic():
+        with connection.cursor() as cursor:
+            cursor.execute('SET LOCAL jit=on')
+            cursor.execute('SET LOCAL join_collapse_limit=6')
+            cursor.execute('SET LOCAL plan_cache_mode=force_custom_plan')
+        before = settings_now()
+        query = candidates({}).annotate(observed_mode=RawSQL(
+            "current_setting('plan_cache_mode')", []))
+        if failure:
+            query = query.annotate(diagnostic_failure=RawSQL('1/0', []))
+            with pytest.raises(DatabaseError):
+                read_publication_values(query, bounded_joins=bounded, prepared_page=prepared,
+                                        generic_page_plan=True)
+        else:
+            rows = read_publication_values(query, bounded_joins=bounded, prepared_page=prepared,
+                                           generic_page_plan=True)
+            assert rows
+            assert {r.observed_mode for r in rows} == {
+                'force_generic_plan' if bounded and prepared else 'force_custom_plan'}
+        assert settings_now() == before
+        assert raw.cursor_factory is factory and raw.prepare_threshold == threshold
+        with connection.cursor() as cursor:
+            cursor.execute('SELECT 1')
+            assert cursor.fetchone()[0] == 1
+    assert settings_now() == initial
