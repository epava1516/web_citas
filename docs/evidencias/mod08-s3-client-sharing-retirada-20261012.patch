+def test_real_rustfs_shared_transport_paired(settings, monkeypatch, object_store, record_property):
+    """AB/BA twenty pairs, no profiler; transport-only, never HTTP acceptance."""
+    real_settings(settings, object_store)
+    writer = factory.repository()
+    refs = [writer.write(io.BytesIO(os.urandom(4 * 1024 * 1024)), b'paired') for _ in range(2)]
+    native_scope = transport.read_clients
+
+    @contextmanager
+    def independent_scope(**kwargs):
+        # Same outer/worker lifecycle, but each worker owns its native SDK client.
+        with native_scope() as state:
+            yield state
+
+    samples = []
+
+    def run(arm):
+        monkeypatch.setattr(transport, 'read_clients',
+                            independent_scope if arm == 'independent' else native_scope)
+        begin, cpu = perf_counter_ns(), process_time_ns()
+        content._verify_objects_in_order((ref, b'paired') for ref in refs)
+        return {'arm': arm, 'wall_ns': perf_counter_ns() - begin,
+                'process_cpu_ns': process_time_ns() - cpu}
+
+    try:
+        for arm in ['independent', 'shared', 'shared', 'independent']:
+            run(arm)
+        for pair in range(20):
+            order = ['independent', 'shared'] if pair % 2 == 0 else ['shared', 'independent']
+            row = {arm: run(arm) for arm in order}
+            samples.append({'pair': pair, 'order': order, **row})
+        gains = [s['independent']['wall_ns'] - s['shared']['wall_ns'] for s in samples]
+        blocks = [statistics.median(gains[i:i + 5]) for i in range(0, 20, 5)]
+        record_property('s3_transport_paired', json.dumps({
+            'scope': 'Two real 4MiB RustFS objects; SDK client sharing per verification only; not HTTP or capacity',
+            'samples': samples, 'block_median_gain_ns': blocks,
+            'median_gain_ns': statistics.median(gains),
+            'positive_pairs': sum(g > 0 for g in gains),
+            'candidate_consistent': all(g > 0 for g in blocks) and statistics.median(gains) > 0,
+        }))
+    finally:
+        monkeypatch.setattr(transport, 'read_clients', native_scope)
+        for ref in refs:
+            writer.purge(ref)
+        writer.client.close()
+
+
