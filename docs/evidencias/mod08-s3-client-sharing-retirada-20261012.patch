+def test_shared_transport_serializes_construction_and_closes_after_join(settings):
+    configured(settings)
+    barrier, finished = Barrier(2), Event()
+    created = []
+
+    def create():
+        result = Client()
+        created.append(result)
+        return result
+
+    with scope.read_clients(shareable=True) as state:
+        def worker():
+            with scope.read_clients(shared=state):
+                barrier.wait(timeout=5)
+                result = scope.client(create)
+                assert result.closed == 0
+                return result
+
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            results = list(pool.map(lambda _: worker(), range(2)))
+        finished.set()
+        assert len(created) == 1 and results[0] is results[1]
+        assert scope._current.get() is state and created[0].closed == 0
+    assert finished.is_set() and created[0].closed == 1
+    assert not state['active'] and scope._current.get() is None
+    with pytest.raises(RuntimeError, match='unavailable'):
+        with scope.read_clients(shared=state):
+            pytest.fail('Expired scope accepted')
+
+
+def test_shared_transport_declines_cross_process_and_rechecks_keys(settings, monkeypatch):
+    configured(settings)
+    with scope.read_clients(shareable=True) as state:
+        first = scope.client(Client)
+        settings.RIGHTS_OBJECT_SECRET_KEY = 'new-synthetic-secret'
+        second = scope.client(Client)
+        assert first is not second
+        with monkeypatch.context() as patch:
+            patch.setattr(scope.os, 'getpid', lambda: -1)
+            assert scope.client(Client) is not second
+            with pytest.raises(RuntimeError, match='unavailable'):
+                with scope.read_clients(shared=state):
+                    pytest.fail('Foreign PID accepted')
+    assert first.closed == second.closed == 1
+
+
 def configured(settings):
