  "helper_definition": "CREATE FUNCTION public.research_bulk_hashes(case_id uuid)\nRETURNS TABLE(row_id text,digest text)\nLANGUAGE sql STABLE SECURITY INVOKER SET search_path=pg_catalog,public AS $$\nSELECT s.id::text,pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(\n pg_catalog.jsonb_set(pg_catalog.to_jsonb(s),'{created_at}',\n pg_catalog.to_jsonb(pg_catalog.to_char(s.created_at AT TIME ZONE 'UTC',\n 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"')))::text,'UTF8')),'hex')\nFROM public.research_rows s WHERE s.case_id=$1 ORDER BY s.id $$",
