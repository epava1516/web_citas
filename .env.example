APP_ENV=development
DJANGO_SECRET_KEY=local-development-only-change-before-any-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
POSTGRES_DB=clasificados
POSTGRES_USER=clasificados
POSTGRES_PASSWORD=local-development-only
DB_HOST=127.0.0.1
DB_PORT=55432
REDIS_URL=redis://127.0.0.1:56379/0
# Use a fresh generation after recovery; never copy it from the restored backup.
# All producers/workers/Beat must restart with the same externally retained value.
TASK_QUEUE_GENERATION=v1
PUBLIC_ORIGIN=http://localhost:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Optional encrypted origins: private per-case directory recommended; never a recipient copy.
# Capture after access inventory preparation. Does not cover historical backups.
ACCESS_LOG_ORIGIN_BUNDLE=
ACCESS_RESOURCE_ORIGIN_BUNDLE=
VERIFICATION_PROVIDER=simulator
PAYMENTS_ENABLED=0
AGENCY_PENDING_PERSON_LIMIT=10

# Dedicated Fernet key required in production; empty uses purpose-specific dev derivation.
SAFETY_ENCRYPTION_KEY=

# Disabled by default. Local simulator stores evidence only; never sends email.
SAFETY_NOTICE_BACKEND=disabled

# Explicit development-only identity/scope simulator; no real provider connected.
RIGHTS_VERIFICATION_BACKEND=disabled

# Development-only destination confirmation; no external delivery
ACCOUNT_CORRECTION_DELIVERY_BACKEND=disabled

# Offline recovery only: restart app, workers and Beat with the same explicit mode.
# HTTP returns503; workers ignore business tasks; Beat clears persisted schedules.
# This flag does not isolate external storage/CDN or authorize reopening the site.
RECOVERY_MODE=0
# Independent keys for the external recovery ledger; never reuse the safety key.
# Fernet encryption key and separately generated URL-safe base64 signing key (>=32 bytes).
RECOVERY_ENCRYPTION_KEY=
RECOVERY_SIGNING_KEY=

# Optional private encrypted retained AOF origin; keeps historical coverage pending.
ACCESS_REDIS_HISTORY_ORIGIN_BUNDLE=

# MOD08 opt-in private S3 blobs; own RustFS Compose profile rights-objects.
RIGHTS_OBJECT_STORAGE_ENABLED=0
RIGHTS_OBJECT_ENDPOINT=http://objects:9000
RIGHTS_OBJECT_REGION=us-east-1
RIGHTS_OBJECT_BUCKET=rights-private
RIGHTS_OBJECT_ACCESS_KEY=
RIGHTS_OBJECT_SECRET_KEY=
# JSON key-ID to base64 32-byte AES key; keep old IDs until objects rotated.
RIGHTS_OBJECT_KEYS={}
RIGHTS_OBJECT_ACTIVE_KEY=
# Caddy shares ephemeral bytes read-only. Independent random proxy secret >=32 chars.
RIGHTS_PROXY_DELIVERY_ENABLED=0
RIGHTS_DELIVERY_PROXY_SECRET=
# Change epoch and invalidate grants before exposing a restored DB.
RIGHTS_DELIVERY_GENERATION=development-v1
# Optional compose.runtime-role.yaml: owner remains POSTGRES_USER, runtime differs.
POSTGRES_RUNTIME_USER=web_modelos_runtime
# Set a distinct local secret before enabling the override; never commit its value.
POSTGRES_RUNTIME_PASSWORD=
